# Server
PORT=5000
# Kept as NODE_ENV so the same .env works for both backends ("production" enables DB SSL)
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/spendai_db

# JWT (same secret as the Node backend => tokens work on either)
JWT_SECRET=some_long_random_string_here
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
